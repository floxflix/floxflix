MONGO_URI=mongodb://localhost:27017/floxflix
JWT_SECRET_KEY=your-secret-key-here #Generate with: openssl rand -base64 48
UPLOAD_FOLDER=./uploads
PORT=7777
HLS_SEGMENT_TIME=10
HLS_LIST_SIZE=0
HLS_SEGMENT_TYPE=fmp4
MAX_FILE_SIZE=2147483648

# All-in-one image: the Go server also serves the built UI.
SERVE_UI=true
# Serve the SPA from disk instead of the embedded build (local UI iteration).
# UI_DIR=./internal/web/dist

# UI runtime configuration, emitted by /config.js at startup. The defaults are
# correct for the all-in-one image: an empty URL means same origin. Set
# VITE_STREAMAPI_URL only when the API lives on a different host.
# VITE_STREAMAPI_URL=
# VITE_STREAMAPI_PREFIX=/v1/api
# VITE_STREAMAPI_PREFIX_ADMIN=/dashboard
# VITE_DEFAULT_NEXT_EPISODE_OFFSET=15

# Only needed for split deployments where the UI runs on another origin.
# The all-in-one image is same-origin, so this stays unset.
# CORS_ORIGIN=http://localhost:5173

# Cookie flags for login/refresh/logout. Defaults: COOKIE_SECURE=true, COOKIE_SAMESITE=lax
# Plain-HTTP LAN deploys (e.g. http://api.floxflix.lan behind the project's k8s ingress)
# must set COOKIE_SECURE=false, or browsers will silently drop the auth cookies.
# Putting TLS in front of the API is the better answer.
# COOKIE_SAMESITE=none requires COOKIE_SECURE=true (browsers reject SameSite=None otherwise).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
